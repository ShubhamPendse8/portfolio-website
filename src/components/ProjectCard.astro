---
import type { Project } from '../lib/content';
import { categoryLabels } from '../lib/content';

export interface Props {
  project: Project;
  variant?: 'featured' | 'standard' | 'compact';
  index?: number;
}
const { project, variant = 'standard', index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const primaryCategory = project.categories?.[0] || '';
const catLabel = categoryLabels[primaryCategory] || primaryCategory;
const cardLabel = project.disciplines?.[0] || catLabel;
const href = link(`/projects/${project.slug}`);
const thumb = project.thumbnail || project.hero_image || '';
const resolvedThumb = thumb ? (thumb.startsWith('http') ? thumb : link(thumb)) : '';
const hasCaseStudy = Array.isArray(project.sections) && project.sections.length > 0;
const isVideoProject = project.categories?.includes('motion') || false;
---
<a
  href={href}
  class:list={['pcard', `pcard--${variant}`, isVideoProject && 'pcard--video']}
  data-testid={`project-card-${project.slug}`}
  data-analytics="project-open"
  data-analytics-slug={project.slug}
  aria-label={`View project: ${project.title}`}
  style={`--stagger:${index * 60}ms`}
>
  <div class="pcard__media">
    {resolvedThumb ? (
      <img
        src={resolvedThumb}
        alt={project.thumbnail_alt || project.title}
        loading="lazy"
        decoding="async"
        width="800"
        height="600"
      />
    ) : (
      <div class="pcard__placeholder" aria-hidden="true">
        <span class="pcard__placeholder-mono">
          {project.title.split(' ').map((w) => w[0]).slice(0, 2).join('')}
        </span>
        <span class="pcard__placeholder-label">{hasCaseStudy ? 'View case study' : 'Case study coming soon'}</span>
      </div>
    )}
    <span class="pcard__media-label" aria-hidden="true">
      <span>Explore project</span>
      <span>↗</span>
    </span>
    <span class="pcard__hover-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M7 17 L17 7" /><path d="M9 7h8v8" />
      </svg>
    </span>
  </div>
  <div class="pcard__body">
    <div class="pcard__meta">
      {cardLabel && <span class="pcard__cat">{cardLabel}</span>}
      {project.year && <span class="pcard__dot" aria-hidden="true">·</span>}
      {project.year && <span class="pcard__year">{project.year}</span>}
    </div>
    <h3 class="pcard__title">{project.title}</h3>
    {variant !== 'compact' && <p class="pcard__summary">{project.summary}</p>}
    {variant !== 'compact' && (
      <span class="pcard__cta" aria-hidden="true">
        View full project <span>→</span>
      </span>
    )}
    {variant === 'featured' && project.disciplines && project.disciplines.length > 0 && (
      <div class="pcard__tags">
        {project.disciplines.slice(0, 3).map((d) => <span class="pcard__tag">{d}</span>)}
      </div>
    )}
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease);
    position: relative;
    isolation: isolate;
  }
  .pcard:hover {
    transform: translateY(-5px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow), 0 20px 70px -36px var(--accent-glow);
    background: linear-gradient(135deg, var(--accent-soft), transparent 56%), var(--surface);
  }
  .pcard:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .pcard__media {
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
    position: relative;
    overflow: hidden;
  }
  .pcard__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 48%, rgba(5,5,5,0.68) 100%);
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }
  .pcard__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out), filter 500ms var(--ease);
    will-change: transform;
  }
  .pcard:hover .pcard__media img { transform: scale(1.065) translateY(-2px); }
  .pcard:hover .pcard__media::after { opacity: 1; }
  .pcard__placeholder {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 10px;
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 65%),
      repeating-linear-gradient(135deg, rgba(255,255,255,0.03) 0 1px, transparent 1px 14px),
      var(--surface-2);
    color: var(--text-muted);
  }
  .pcard__placeholder-mono {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--accent);
    letter-spacing: -0.03em;
  }
  .pcard__placeholder-label { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dim); }

  .pcard__media-label {
    position: absolute;
    left: 16px;
    bottom: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 11px;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 999px;
    background: rgba(8,8,9,0.66);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 320ms var(--ease), transform 420ms var(--ease-out);
  }
  .pcard:hover .pcard__media-label,
  .pcard:focus-visible .pcard__media-label { opacity: 1; transform: translateY(0); }

  .pcard__hover-arrow {
    position: absolute;
    top: 16px; right: 16px;
    z-index: 2;
    width: 36px; height: 36px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #0a0403;
    opacity: 0; transform: translate(6px, -6px) scale(0.94);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .pcard:hover .pcard__hover-arrow,
  .pcard:focus-visible .pcard__hover-arrow { opacity: 1; transform: translate(0, 0) scale(1); }

  .pcard__body { padding: 22px 24px 26px; flex: 1; }
  .pcard__meta { display: flex; gap: 8px; align-items: center; color: var(--text-dim); font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; }
  .pcard__cat { color: var(--accent); }
  .pcard__dot { color: var(--text-dim); }
  .pcard__title { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -0.015em; font-weight: 500; transition: color var(--dur-fast) var(--ease); }
  .pcard:hover .pcard__title { color: var(--accent-warm); }
  .pcard__summary { color: var(--text-muted); margin-top: 10px; font-size: 0.94rem; line-height: 1.6; }
  .pcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pcard__cta span { transition: transform var(--dur) var(--ease); }
  .pcard:hover .pcard__cta span { transform: translateX(4px); }
  .pcard--standard .pcard__body { display: flex; flex-direction: column; }
  .pcard--standard .pcard__cta { margin-top: auto; padding-top: 18px; }
  .pcard__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .pcard__tag {
    font-size: 0.72rem;
    padding: 4px 10px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* Featured variant */
  .pcard--featured .pcard__media { aspect-ratio: 16 / 10; }
  .pcard--featured .pcard__title { font-size: 1.8rem; }
  .pcard--featured .pcard__body { padding: 28px 30px 32px; }

  /* Compact variant */
  .pcard--compact .pcard__media { aspect-ratio: 1 / 1; }
  .pcard--compact .pcard__title { font-size: 1.15rem; }
  .pcard--compact .pcard__body { padding: 18px 20px 22px; }

  /* Video and motion projects keep native 16:9 thumbnail framing. */
  .pcard--video .pcard__media { aspect-ratio: 16 / 9; }

  @media (hover: none), (pointer: coarse) {
    .pcard:hover {
      transform: none;
      border-color: var(--border);
      box-shadow: none;
      background: var(--surface);
    }
    .pcard:hover .pcard__media img { transform: none; }
    .pcard:hover .pcard__media::after { opacity: 0; }
    .pcard:hover .pcard__title { color: var(--text); }
    .pcard__media-label, .pcard__hover-arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pcard__media img, .pcard__media-label, .pcard__hover-arrow { transition: none; }
    .pcard:hover .pcard__media img { transform: none; }
  }
  @media (max-width: 540px) {
    .pcard--featured .pcard__title { font-size: 1.4rem; }
    .pcard__body { padding: 18px 18px 22px; }
  }
</style>
