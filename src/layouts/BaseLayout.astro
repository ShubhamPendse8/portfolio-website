---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandMenu from '../components/CommandMenu.astro';
import Lightbox from '../components/Lightbox.astro';
import { site, activeSocials } from '../lib/content';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  path?: string;
  bodyClass?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage,
  path = Astro.url.pathname,
  bodyClass = '',
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = (Astro.site ?? new URL('https://shubhampendse8.github.io')).origin;
const suppliedTitle = title?.trim() || '';
const pageTitle = suppliedTitle
  ? suppliedTitle.toLowerCase().includes(site.name.toLowerCase())
    ? suppliedTitle
    : `${suppliedTitle} — ${site.name}`
  : site.seo.title;
const pageDesc = description || site.seo.description;
const socialImgRaw = ogImage || site.seo.og_image || '';

const resolveAsset = (p: string) => {
  if (!p) return '';
  if (/^https?:\/\//.test(p)) return p;
  return `${base}${p.startsWith('/') ? p : '/' + p}`;
};
/** Fully-qualified absolute URL for social sharing / canonical. */
const absoluteURL = (p: string) => {
  if (!p) return '';
  if (/^https?:\/\//.test(p)) return p;
  return `${origin}${resolveAsset(p)}`;
};

const canonicalURL = `${origin}${base}${path.startsWith(base) ? path.slice(base.length) : path}`.replace(/\/+$/, '') || `${origin}${base}/`;
const socialImgAbs = absoluteURL(socialImgRaw);
const personImageAbs = absoluteURL(site.avatar || '');

// Person JSON-LD for the homepage
const socials = activeSocials().map((s) => s.href).filter((h) => /^https?:\/\//.test(h));
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  email: site.email,
  url: `${origin}${base}/`,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  image: personImageAbs || undefined,
  sameAs: socials,
};

const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

// Optional analytics
const analytics = site.analytics ?? { provider: 'none' } as any;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Prevent white / wrong-theme flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    {socialImgAbs && <meta property="og:image" content={socialImgAbs} />}
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    {socialImgAbs && <meta name="twitter:image" content={socialImgAbs} />}

    <!-- Person JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    {jsonLdBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Favicons -->
    <link rel="icon" href={resolveAsset('/assets/icons/favicon-32.png')} sizes="32x32" />
    <link rel="icon" href={resolveAsset('/assets/icons/favicon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={resolveAsset('/assets/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={resolveAsset('/site.webmanifest')} />

    <!-- Fonts: Fraunces (display) + Instrument Sans (body) — distinctive editorial pairing -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..500;1,9..144,300..500&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {analytics.provider === 'plausible' && analytics.domain && (
      <script is:inline defer data-domain={analytics.domain} src={analytics.script_url || 'https://plausible.io/js/script.js'}></script>
    )}
    {analytics.provider === 'umami' && analytics.site_id && analytics.script_url && (
      <script is:inline async defer data-website-id={analytics.site_id} src={analytics.script_url}></script>
    )}
    {analytics.provider === 'ga4' && analytics.site_id && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.site_id}`}></script>
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analytics.site_id}',{anonymize_ip:true});`} />
    )}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class={bodyClass}>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />
    <CommandMenu />

    <style>
      .scroll-progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: 90;
        pointer-events: none;
        background: transparent;
      }
      .scroll-progress span {
        display: block;
        width: 100%;
        height: 100%;
        transform: scaleX(0);
        transform-origin: left center;
        background: var(--accent);
        box-shadow: 0 0 14px var(--accent-glow);
        will-change: transform;
      }
    </style>

    <script>
      // @ts-nocheck
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Slim global scroll-progress indicator. Uses transform only to avoid layout work.
      const progressBar = document.querySelector('[data-scroll-progress]');
      let progressQueued = false;
      const updateProgress = () => {
        if (!progressBar) return;
        const doc = document.documentElement;
        const max = Math.max(0, doc.scrollHeight - window.innerHeight);
        const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        progressBar.style.transform = `scaleX(${ratio})`;
        progressQueued = false;
      };
      const queueProgress = () => {
        if (progressQueued) return;
        progressQueued = true;
        requestAnimationFrame(updateProgress);
      };
      window.addEventListener('scroll', queueProgress, { passive: true });
      window.addEventListener('resize', queueProgress, { passive: true });
      updateProgress();

      // Desktop-only hero depth. `translate` layers on top of the existing floating transform animation.
      const heroVisual = document.querySelector('.hero__visual');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (heroVisual && finePointer.matches && !reducedMotion.matches) {
        const avatar = heroVisual.querySelector('.hero__avatar');
        const grid = heroVisual.querySelector('.hero__grid');
        const caption = heroVisual.querySelector('.hero__caption');
        const layers = [avatar, grid, caption].filter(Boolean);
        layers.forEach((el) => { el.style.willChange = 'translate'; });

        let heroFrame = 0;
        let nextX = 0;
        let nextY = 0;
        const renderHeroDepth = () => {
          if (avatar) avatar.style.translate = `${nextX * 7}px ${nextY * 7}px`;
          if (grid) grid.style.translate = `${nextX * 3}px ${nextY * 3}px`;
          if (caption) caption.style.translate = `${-nextX * 4}px ${-nextY * 4}px`;
          heroFrame = 0;
        };
        const setHeroDepth = (x, y) => {
          nextX = x;
          nextY = y;
          if (!heroFrame) heroFrame = requestAnimationFrame(renderHeroDepth);
        };

        heroVisual.addEventListener('pointermove', (event) => {
          const rect = heroVisual.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
          setHeroDepth(x, y);
        }, { passive: true });
        heroVisual.addEventListener('pointerleave', () => setHeroDepth(0, 0), { passive: true });
      }

      // Make every resume CTA behave like its label: download the PDF rather than opening a new tab.
      document.querySelectorAll('[data-analytics="resume-click"]').forEach((el) => {
        if (el instanceof HTMLAnchorElement) {
          el.setAttribute('download', 'Shubham-Pendse-Resume.pdf');
          el.removeAttribute('target');
          el.removeAttribute('rel');
        }
      });

      // Lightweight analytics event dispatch (only fires if an analytics provider is loaded).
      const track = (name, props) => {
        try {
          if (window.plausible) window.plausible(name, { props: props || {} });
          else if (window.umami) window.umami.track(name, props || {});
          else if (window.gtag) window.gtag('event', name, props || {});
        } catch (e) {}
      };
      document.addEventListener('click', (e) => {
        const el = e.target.closest && e.target.closest('[data-analytics]');
        if (!el) return;
        const name = el.getAttribute('data-analytics');
        track(name, {});
      });
      window.__portfolioTrack = track;
    </script>
  </body>
</html>
