---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getAllProjects, getCategories } from '../lib/content';

const projects = getAllProjects();
const categories = getCategories();
const totalCount = projects.length;
---
<BaseLayout title="Work" description="Selected work by Shubham Pendse across social media, UI/UX, branding, presentations, print and motion." path="/work">
  <section class="work-hero">
    <div class="container">
      <span class="eyebrow reveal">Work</span>
      <h1 class="work-hero__title reveal">
        Projects that <em>speak clearly</em><br/>and stay on brand.
      </h1>
      <p class="work-hero__sub lead reveal">
        A curated collection across visual design, digital experiences, branding, presentations, print and motion. Filter by discipline or scroll to see everything.
      </p>
    </div>
  </section>

  <!-- Filters -->
  <section class="filters" aria-label="Filter projects by category">
    <div class="container">
      <div class="filters__bar glass" data-testid="project-filters">
        <button
          class="chip is-active"
          type="button"
          data-filter="all"
          aria-pressed="true"
          data-testid="filter-all"
        >
          All work <span class="chip__count">{totalCount}</span>
        </button>
        {categories.map((c) => (
          <button
            class="chip"
            type="button"
            data-filter={c.id}
            aria-pressed="false"
            data-testid={`filter-${c.id}`}
          >
            {c.label} <span class="chip__count">{c.count}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="section-tight">
    <div class="container">
      <div class="pgrid" data-project-grid>
        {projects.map((p, i) => (
          <div
            class="pgrid__cell reveal"
            data-cats={p.categories.join(',')}
            data-project-slug={p.slug}
            style={`--stagger:${(i % 6) * 60}ms`}
          >
            <ProjectCard project={p} variant="standard" index={i} />
          </div>
        ))}

        <div class="pgrid__cell pgrid__cell--coming-soon" data-video-coming-soon hidden>
          <article class="coming-card" aria-label="More video work coming soon">
            <div class="coming-card__media" aria-hidden="true">
              <div class="coming-card__play">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M8 6.5v11l9-5.5-9-5.5Z" />
                </svg>
              </div>
              <span class="coming-card__kicker">Next cuts in progress</span>
            </div>
            <div class="coming-card__body">
              <span class="coming-card__category">Video Editing & Motion</span>
              <h3 class="coming-card__title">More video work coming soon</h3>
              <p class="coming-card__copy">Additional client edits, reels and short-form work are being added.</p>
            </div>
          </article>
        </div>
      </div>
      <div class="pgrid__empty" data-project-empty hidden>
        <span class="eyebrow">Nothing here yet</span>
        <p class="lead">No projects in this category yet — check back soon or explore all work.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-hero { padding-top: 20px; padding-bottom: clamp(20px, 3vw, 36px); }
  .work-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.8vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 18px 0 16px;
    font-weight: 350;
    text-wrap: balance;
  }
  .work-hero__title em { color: var(--accent); font-style: italic; font-weight: 350; }
  .work-hero__sub { max-width: 680px; }

  .filters { position: sticky; top: calc(var(--nav-height) + 20px); z-index: 20; padding: 10px 0; }
  .filters__bar {
    display: flex;
    gap: 8px;
    padding: 8px;
    border-radius: 999px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .filters__bar::-webkit-scrollbar { display: none; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .chip:hover { color: var(--text); background: var(--surface); }
  .chip.is-active {
    color: #0a0403;
    background: var(--accent);
    border-color: var(--accent);
  }
  .chip__count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(255,255,255,0.14);
    color: inherit;
  }
  .chip:not(.is-active) .chip__count { background: var(--surface-2); color: var(--text-dim); }

  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .pgrid__cell { transition-delay: var(--stagger, 0ms); }
  .pgrid__cell.is-hidden { display: none; }

  .coming-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--text);
    background: linear-gradient(145deg, var(--accent-soft), transparent 58%), var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }
  .coming-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, var(--accent-soft), transparent 38%),
      repeating-linear-gradient(135deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 16px),
      var(--surface-2);
    border-bottom: 1px dashed var(--border);
  }
  .coming-card__play {
    width: 66px;
    height: 66px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--accent);
    background: var(--surface);
    box-shadow: 0 18px 60px -32px var(--accent-glow);
  }
  .coming-card__kicker {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .coming-card__body {
    flex: 1;
    padding: 22px 24px 26px;
  }
  .coming-card__category {
    display: block;
    margin-bottom: 12px;
    color: var(--accent);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .coming-card__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    font-weight: 500;
  }
  .coming-card__copy {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) { .pgrid { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
  @media (max-width: 560px) { .pgrid { grid-template-columns: 1fr; gap: 18px; } }

  @media (max-width: 640px) {
    .work-hero { padding-top: 20px; padding-bottom: 30px; }
    .work-hero__title { margin: 16px 0 14px; }
    .filters { top: calc(var(--nav-height) + 12px); padding: 10px 0; }
    .filters__bar { padding: 6px; }
    .chip { padding: 8px 12px; font-size: 0.82rem; }
    .coming-card__body { padding: 18px 18px 22px; }
  }

  .pgrid__empty {
    text-align: center;
    padding: 80px 20px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }
</style>

<script>
  // @ts-nocheck
  const params = new URLSearchParams(window.location.search);
  const initial = params.get('category') || 'all';

  const buttons = document.querySelectorAll('[data-filter]');
  const grid = document.querySelector('[data-project-grid]');
  const cells = Array.from(document.querySelectorAll('[data-cats]'));
  const empty = document.querySelector('[data-project-empty]');
  const comingSoon = document.querySelector('[data-video-coming-soon]');
  const originalOrder = new Map(cells.map((el, index) => [el, index]));

  // Keep the main All Work grid untouched, but lead the UI/UX filter with
  // the two full case studies before the older visual UI concepts.
  const categoryPriority = {
    'ui-ux': [
      'phoenix-ortho-hospital-website-redesign',
      'online-yoga-app-ux-case-study',
    ],
  };

  const arrangeForCategory = (id) => {
    if (!grid) return;
    const priority = categoryPriority[id] || [];
    const priorityIndex = new Map(priority.map((slug, index) => [slug, index]));

    [...cells]
      .sort((a, b) => {
        const aPriority = priorityIndex.has(a.dataset.projectSlug)
          ? priorityIndex.get(a.dataset.projectSlug)
          : Number.MAX_SAFE_INTEGER;
        const bPriority = priorityIndex.has(b.dataset.projectSlug)
          ? priorityIndex.get(b.dataset.projectSlug)
          : Number.MAX_SAFE_INTEGER;

        if (aPriority !== bPriority) return aPriority - bPriority;
        return originalOrder.get(a) - originalOrder.get(b);
      })
      .forEach((el) => grid.appendChild(el));

    if (comingSoon) grid.appendChild(comingSoon);
  };

  const applyFilter = (id) => {
    arrangeForCategory(id);

    let visible = 0;
    cells.forEach((el) => {
      const cats = (el.dataset.cats || '').split(',').filter(Boolean);
      const show = id === 'all' || cats.includes(id);
      el.classList.toggle('is-hidden', !show);
      if (show) visible++;
    });
    if (comingSoon) comingSoon.hidden = id !== 'motion';
    buttons.forEach((b) => {
      const active = b.dataset.filter === id;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    if (empty) empty.hidden = visible !== 0;
    const url = new URL(window.location.href);
    if (id === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', id);
    window.history.replaceState({}, '', url);
  };

  buttons.forEach((b) => {
    b.addEventListener('click', () => applyFilter(b.dataset.filter || 'all'));
  });

  if (initial !== 'all') applyFilter(initial);
</script>
