---
import BaseLayout from '../layouts/BaseLayout.astro';
import CreativeAccess from '../components/CreativeAccess.astro';
import { site, getFeaturedProjects } from '../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = getFeaturedProjects().slice(0, 4);
const portrait = `${base}/uploads/shubham-access-portrait.webp`;
---
<BaseLayout
  title="Creative Access"
  description="Shubham Pendse — Graphic Designer & UI/UX Designer."
  bodyClass="page-home creative-access-home"
>
  <CreativeAccess projects={projects} site={site} base={base} portrait={portrait} />
</BaseLayout>
